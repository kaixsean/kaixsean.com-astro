---
import "@fontsource-variable/inter";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar.astro";
import { checkImageUrl } from "@/utils/all";
import { SEO } from "astro-seo";

export interface Props {
  title?: string;
  desc?: string;
  ogimage?: string;
  pageType?: "website" | "article";
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    section?: string;
    tags?: string[];
  };
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const {
  title,
  desc,
  ogimage = "/facebook-logo.png",
  pageType = "website",
  article,
} = Astro.props;

const resolvedOGImage = checkImageUrl(ogimage, Astro.site);
const googleAnalyticsId = "G-BSQNFNY4X2";
const pageDescription = desc || "Kaixsean 的個人部落格，紀錄我的好奇與困惑。";

const makeTitle = title
  ? title + " | " + "Kaixsean"
  : "Kaixsean — 紀錄我的好奇與困惑";

const articleMetaTags =
  pageType === "article" && article
    ? [
        article.publishedTime ? `<meta property="article:published_time" content="${article.publishedTime}" />` : "",
        article.modifiedTime ? `<meta property="article:modified_time" content="${article.modifiedTime}" />` : "",
        article.authors?.length ? article.authors.map((authorName) => `<meta property="article:author" content="${authorName}" />`).join("") : "",
        article.section ? `<meta property="article:section" content="${article.section}" />` : "",
        ...(article.tags ?? []).map((tag) => `<meta property="article:tag" content="${tag}" />`),
      ].join("")
    : "";
---

<!DOCTYPE html>
<html lang="zh-tw" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#030712" />

    <!-- Blocking script: set dark class before first paint to prevent FOUC -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = saved === "dark" || (saved !== "light" && prefersDark);
        if (isDark) document.documentElement.classList.add("dark");
      })();
    </script>

    <SEO
      title={makeTitle}
      description={pageDescription}
      canonical={canonicalURL}
      twitter={{
        creator: "@kaixsean",
        site: "@kaixsean",
        card: "summary_large_image",
        title: makeTitle,
        description: pageDescription,
        image: resolvedOGImage,
        imageAlt: title ? `${title} cover image` : "Kaixsean",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: pageType,
          title: makeTitle,
          image: resolvedOGImage,
        },
        optional: {
          description: pageDescription,
          siteName: "Kaixsean",
          locale: "zh_TW",
        },
        image: {
          url: resolvedOGImage,
          alt: title ? `${title} cover image` : "Kaixsean",
        },
        article,
      }}
    />

    <meta property="og:locale" content="zh_TW" />
    <Fragment set:html={articleMetaTags} />

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
    <script is:inline define:vars={{ googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", googleAnalyticsId);
    </script>
  </head>
  <body class="bg-white pl-[calc(100vw-100%)] text-black antialiased dark:bg-gray-950 dark:text-white">
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
