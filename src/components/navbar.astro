---
interface NavLink {
  href: string;
  title: string;
  external?: boolean;
}

import { Icon } from "astro-icon/components";

const navLinks: NavLink[] = [
  { href: "/", title: "Home" },
  { href: "/blog", title: "Blog" },
  { href: "/category", title: "Category" },
  { href: "https://buymeacoffee.com/kaixdev", title: "Support", external: true },
  { href: "/about", title: "About" },
  { href: "/portfolio", title: "Portfolio" },
];

const desktopLinks = navLinks.filter((link) => link.href !== "/");
---

<header
  class="sticky top-0 z-50 border-b border-gray-950/10 bg-white/70 py-3 backdrop-blur-sm transition-colors dark:border-gray-50/[0.06] dark:bg-gray-950/60">
  <div class="mx-auto max-w-full px-4 sm:px-6 md:max-w-3xl lg:max-w-5xl">
    <div class="flex items-center justify-between">

      <!-- Logo -->
      <a href="/" aria-label="Kaixsean home">
        <img
          src="/logo.svg"
          alt="Kaixsean"
          width="102"
          height="40"
        />
      </a>

      <!-- Desktop nav + controls -->
      <div class="flex items-center space-x-4 leading-5 sm:space-x-6">
        {
          desktopLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="hidden font-medium text-gray-600 transition duration-300 ease-in-out hover:text-sky-600 sm:block dark:text-gray-100 dark:hover:text-sky-400">
              {link.title}
            </a>
          ))
        }

        <div class="relative">
          <button
            id="theme-menu-button"
            type="button"
            aria-label="Theme: System"
            aria-expanded="false"
            aria-controls="theme-menu"
            class="flex items-center justify-center gap-1 text-gray-600 transition hover:text-sky-600 dark:text-gray-300 dark:hover:text-sky-400">
            <Icon data-current-theme="light" class="theme-current-icon hidden h-5 w-5" name="heroicons:sun" />
            <Icon data-current-theme="system" class="theme-current-icon h-5 w-5" name="heroicons:computer-desktop" />
            <Icon data-current-theme="dark" class="theme-current-icon hidden h-5 w-5" name="heroicons:moon" />
            <Icon class="h-3 w-3" name="heroicons:chevron-down" />
          </button>
          <div
            id="theme-menu"
            role="menu"
            aria-label="Theme"
            class="absolute right-0 top-full z-60 mt-2 hidden w-32 rounded-md border border-gray-200 bg-white p-1 shadow-lg dark:border-gray-700 dark:bg-gray-900">
            <button type="button" role="menuitemradio" aria-checked="false" data-theme="light" class="theme-option flex w-full items-center gap-2 rounded px-2 py-1.5 text-left text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800">
              <Icon class="h-4 w-4" name="heroicons:sun" />
              <span>Light</span>
            </button>
            <button type="button" role="menuitemradio" aria-checked="false" data-theme="system" class="theme-option flex w-full items-center gap-2 rounded px-2 py-1.5 text-left text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800">
              <Icon class="h-4 w-4" name="heroicons:computer-desktop" />
              <span>System</span>
            </button>
            <button type="button" role="menuitemradio" aria-checked="false" data-theme="dark" class="theme-option flex w-full items-center gap-2 rounded px-2 py-1.5 text-left text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800">
              <Icon class="h-4 w-4" name="heroicons:moon" />
              <span>Dark</span>
            </button>
          </div>
        </div>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          aria-label="Toggle menu"
          class="flex items-center justify-center text-gray-900 sm:hidden dark:text-gray-100">
          <svg
            id="icon-hamburger"
            class="h-8 w-8"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  id="mobile-overlay"
  class="fixed inset-0 z-60 bg-black/25 opacity-0 transition-opacity duration-300 pointer-events-none">
</div>

<!-- Mobile menu drawer (slides in from right) -->
<div
  id="mobile-drawer"
  class="fixed top-0 right-0 z-70 h-full w-full translate-x-full bg-white opacity-0 transition-all duration-300 ease-in-out dark:bg-gray-950">

  <!-- Close button -->
  <button
    id="mobile-close-btn"
    aria-label="Close menu"
    class="absolute top-7 right-4 h-16 w-16 p-4 text-gray-900 hover:text-sky-600 dark:text-gray-100 dark:hover:text-sky-400">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
      <path
        fill-rule="evenodd"
        d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
        clip-rule="evenodd"></path>
    </svg>
  </button>

  <!-- Mobile nav links -->
  <nav class="mt-8 flex h-full flex-col items-start overflow-y-auto pt-2 pl-12">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          class="mobile-nav-link mb-4 py-2 pr-4 text-2xl font-bold tracking-widest text-gray-900 hover:text-sky-600 dark:text-gray-100 dark:hover:text-sky-400">
          {link.title}
        </a>
      ))
    }
  </nav>
</div>

<script is:inline>
  const themeMenuButton = document.getElementById("theme-menu-button");
  const themeMenu = document.getElementById("theme-menu");
  const themeCurrentIcons = document.querySelectorAll(".theme-current-icon");
  const themeOptions = document.querySelectorAll(".theme-option");
  const colorScheme = window.matchMedia("(prefers-color-scheme: dark)");
  const savedTheme = localStorage.getItem("theme");

  function applyTheme(theme) {
    const isDark = theme === "dark" || (theme === "system" && colorScheme.matches);
    document.documentElement.classList.toggle("dark", isDark);
  }

  const activeTheme = ["light", "system", "dark"].includes(savedTheme) ? savedTheme : "system";
  themeMenuButton.setAttribute("aria-label", `Theme: ${activeTheme}`);
  themeCurrentIcons.forEach((icon) => {
    icon.classList.toggle("hidden", icon.dataset.currentTheme !== activeTheme);
  });
  themeOptions.forEach((option) => {
    option.setAttribute("aria-checked", String(option.dataset.theme === activeTheme));
  });
  applyTheme(activeTheme);

  themeMenuButton.addEventListener("click", () => {
    const isOpen = themeMenu.classList.toggle("hidden");
    themeMenuButton.setAttribute("aria-expanded", String(!isOpen));
  });

  themeOptions.forEach((option) => option.addEventListener("click", () => {
    const selectedTheme = option.dataset.theme;
    localStorage.setItem("theme", selectedTheme);
    themeMenuButton.setAttribute("aria-label", `Theme: ${selectedTheme}`);
    themeCurrentIcons.forEach((icon) => {
      icon.classList.toggle("hidden", icon.dataset.currentTheme !== selectedTheme);
    });
    themeOptions.forEach((item) => {
      item.setAttribute("aria-checked", String(item === option));
    });
    themeMenu.classList.add("hidden");
    themeMenuButton.setAttribute("aria-expanded", "false");
    applyTheme(selectedTheme);
  }));

  document.addEventListener("click", (event) => {
    if (!themeMenuButton.contains(event.target) && !themeMenu.contains(event.target)) {
      themeMenu.classList.add("hidden");
      themeMenuButton.setAttribute("aria-expanded", "false");
    }
  });

  colorScheme.addEventListener("change", () => {
    if (localStorage.getItem("theme") === "system") applyTheme("system");
  });

  // ─── Mobile menu ────────────────────────────────────────────────────────────
  const openBtn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("mobile-close-btn");
  const overlay = document.getElementById("mobile-overlay");
  const drawer = document.getElementById("mobile-drawer");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  function openMenu() {
    overlay.classList.remove("opacity-0", "pointer-events-none");
    overlay.classList.add("opacity-100");
    drawer.classList.remove("translate-x-full", "opacity-0");
    drawer.classList.add("translate-x-0", "opacity-100");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    overlay.classList.remove("opacity-100");
    overlay.classList.add("opacity-0", "pointer-events-none");
    drawer.classList.remove("translate-x-0", "opacity-100");
    drawer.classList.add("translate-x-full", "opacity-0");
    document.body.style.overflow = "";
  }

  openBtn.addEventListener("click", openMenu);
  closeBtn.addEventListener("click", closeMenu);
  overlay.addEventListener("click", closeMenu);
  mobileLinks.forEach((link) => link.addEventListener("click", closeMenu));
</script>
